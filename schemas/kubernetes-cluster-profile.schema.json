{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator-owned Kubernetes cluster profile",
  "description": "Non-secret deployment constraints used to validate a rendered manifest. This profile is environment-specific and must not be committed with live inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "ingress_namespace", "hostname", "oidc_auth_url", "redis_cidrs", "image_digest"],
  "properties": {
    "namespace": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
    "ingress_namespace": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
    "hostname": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"},
    "oidc_auth_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "redis_cidrs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "ipv4-or-ipv6-network"}
    },
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
