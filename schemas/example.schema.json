{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ielts-strategy.dev/schemas/example.schema.json",
  "title": "Published IELTS Learning Example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "strategy_id",
    "skill",
    "task",
    "content",
    "strategy_application",
    "learning_note",
    "provenance",
    "review",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "schema_version": {
      "const": "1.0"
    },
    "strategy_id": {
      "$ref": "strategy.schema.json#/properties/id"
    },
    "skill": {
      "enum": [
        "speaking",
        "writing",
        "reading",
        "listening",
        "general"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "strategy_application": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "learning_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "provenance": {
      "$ref": "strategy.schema.json#/$defs/publicProvenance"
    },
    "review": {
      "$ref": "strategy.schema.json#/$defs/publicReview"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    }
  }
}
