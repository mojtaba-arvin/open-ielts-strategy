{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published IELTS Learning Path",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "title",
    "skill",
    "description",
    "objectives",
    "steps",
    "prerequisites",
    "provenance",
    "review",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "skill": {
      "enum": [
        "speaking",
        "writing",
        "reading",
        "listening",
        "general"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "strategy_id",
          "activity"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "strategy_id": {
            "type": "string",
            "minLength": 1
          },
          "activity": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "strategy.schema.json#/$defs/publicProvenance"
    },
    "review": {
      "$ref": "strategy.schema.json#/$defs/publicReview"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
